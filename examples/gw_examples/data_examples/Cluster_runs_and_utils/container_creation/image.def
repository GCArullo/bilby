Bootstrap: docker
From: ubuntu:26.04

%environment
    # set up environment for when using the container
    . /opt/conda/etc/profile.d/conda.sh
    conda activate bilby
    export LAL_DATA_PATH="/opt/lalsimulation-data${LAL_DATA_PATH:+:${LAL_DATA_PATH}}"

%post
    # base os
    apt-get update -y
    apt-get install -y build-essential wget git git-lfs libgsl-dev swig
    git lfs install --skip-repo

    # install miniconda
    wget -4 https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh
    bash Miniconda3-latest-Linux-x86_64.sh -b -f -p /opt/conda
    rm Miniconda3-latest-Linux-x86_64.sh

    # install conda components - add the packages you need here
    . /opt/conda/etc/profile.d/conda.sh
    conda activate
    conda config --env --add channels conda-forge
    conda config --env --remove channels defaults
    conda config --env --set channel_priority strict

    conda create -y -n bilby python=3.12 numpy pip mpich mpi4py
    conda activate bilby
    conda update --all

    # install Bilby and bilby-pipe from the selected refs
    # Fetch upstream release tags so setuptools-scm reports Bilby's actual
    # release series and satisfies parallel_bilby's bilby>=2 requirement.
    git clone --branch "{{ BILBY_BRANCH }}" https://github.com/GCArullo/bilby.git /tmp/bilby
    git -C /tmp/bilby fetch --tags https://github.com/bilby-dev/bilby.git
    pip install "bilby[gw,parallel] @ git+file:///tmp/bilby@{{ BILBY_BRANCH }}" \
        numpy==2.2.6 scipy==1.14.0 lalsuite==7.26.15
    rm -rf /tmp/bilby
    pip install "bilby_pipe @ git+https://git.ligo.org/gregorio.carullo/bilby-pipe-gc.git@{{ BILBY_PIPE_BRANCH }}"
    pip install bilby_tgr

    # pygsl_lite, a pyseobnr dependency, calls distutils' spawn() with
    # positional arguments. setuptools 84.0.0 made them keyword-only, so the
    # wheel build fails with 'spawn() takes 1 positional argument but 3 were
    # given'. PIP_CONSTRAINT does not reach pip's isolated build environment,
    # so build pygsl_lite against a pinned setuptools instead and supply its
    # other build dependencies by hand. pyseobnr then finds it already
    # installed. Drop this once pygsl_lite stops using the old signature.
    # Schwimmbad 0.3.2 also needs setuptools 80's pkg_resources API.
    pip install "setuptools<81" setuptools_scm wheel
    pip install --no-build-isolation pygsl_lite
    pip install pyseobnr==0.3.7
    # Retain the waveform version used by existing SEOBNRv5PHM analyses.
    # Select it with PYTHONPATH=/opt/pyseobnr-0.3.6 in the job environment.
    pip install --no-deps --target /opt/pyseobnr-0.3.6 pyseobnr==0.3.6

    # Pin the Dali branch: the PyPI teobresums release is a different model.
    git clone https://bitbucket.org/teobresums/teobresums.git /tmp/teobresums
    cd /tmp/teobresums
    git checkout 7b9b3fd951f51412bcaeb50965c7a2c77c9b09a8
    git rev-parse HEAD > /opt/teobresums_commit.txt
    cd Python
    pip install --no-build-isolation .
    cd /
    rm -rf /tmp/teobresums

    # install PESummary from the selected pesummary_GC ref
    pip install "pesummary @ git+https://git.ligo.org/gregorio.carullo/pesummary_GC.git@{{ PESUMMARY_REF }}"

    # LALSuite >= 7.25 ships surrogate data separately from the library.
    # NRSur7dq4 analyses need the waveform surrogate and PESummary's NRSur_fits
    # needs the remnant surrogate. The cluster copies under
    # /scratch/lalsimulation exist on CIT nodes only, so carry both files in
    # the image for jobs that land on OSG sites.
    mkdir -p /opt/lalsimulation-data
    GIT_LFS_SKIP_SMUDGE=1 git clone --depth 1 \
        https://git.ligo.org/waveforms/software/lalsuite-waveform-data.git \
        /tmp/lalsuite-waveform-data
    cd /tmp/lalsuite-waveform-data
    git lfs pull --include "waveform_data/NRSur7dq4_v1.0.h5,waveform_data/NRSur7dq4Remnant_v1.0.h5"
    mv waveform_data/NRSur7dq4_v1.0.h5 \
        waveform_data/NRSur7dq4Remnant_v1.0.h5 \
        /opt/lalsimulation-data/
    cd /
    rm -rf /tmp/lalsuite-waveform-data

    # cleanup
    apt-get clean -y
    pip cache purge

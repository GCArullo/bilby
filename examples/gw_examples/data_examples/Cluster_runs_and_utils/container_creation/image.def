Bootstrap: docker
From: ubuntu:26.04

%environment
    # set up environment for when using the container
    . /opt/conda/etc/profile.d/conda.sh
    conda activate bilby

%post
    # base os
    apt-get update -y
    apt-get install -y build-essential wget git git-lfs libgsl-dev swig
    git lfs install --skip-repo

    # install miniconda
    wget -4 https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh
    bash Miniconda3-latest-Linux-x86_64.sh -b -f -p /opt/conda
    rm Miniconda3-latest-Linux-x86_64.sh

    # install conda components - add the packages you need here
    . /opt/conda/etc/profile.d/conda.sh
    conda activate
    conda config --env --add channels conda-forge
    conda config --env --remove channels defaults
    conda config --env --set channel_priority strict

    conda create -y -n bilby python=3.12 numpy pip
    conda activate bilby
    conda update --all

    # install Bilby and bilby-pipe from the selected refs
    pip install "bilby[gw] @ git+https://github.com/GCArullo/bilby.git@{{ BILBY_BRANCH }}"
    pip install "bilby_pipe @ git+https://git.ligo.org/gregorio.carullo/bilby-pipe-gc.git@{{ BILBY_PIPE_BRANCH }}"
    pip install bilby_tgr

    # pygsl_lite, a pyseobnr dependency, calls distutils' spawn() with
    # positional arguments. setuptools 84.0.0 made them keyword-only, so the
    # wheel build fails with 'spawn() takes 1 positional argument but 3 were
    # given'. pip reads PIP_CONSTRAINT when it builds the isolated environment,
    # so this holds the build-time setuptools at the last working release.
    # Drop the constraint once pygsl_lite stops using the old signature.
    printf 'setuptools<84\n' > /tmp/pip-build-constraint.txt
    PIP_CONSTRAINT=/tmp/pip-build-constraint.txt pip install pyseobnr
    rm /tmp/pip-build-constraint.txt

    # install PESummary from the selected pesummary_GC ref
    pip install "pesummary @ git+https://git.ligo.org/gregorio.carullo/pesummary_GC.git@{{ PESUMMARY_REF }}"

    # LALSuite >= 7.25 ships the waveform surrogates separately from the
    # library. PESummary's NRSur_fits reads the remnant surrogate, and the
    # cluster copy under /scratch/lalsimulation exists on CIT nodes only, so a
    # results page that flocks to an OSG site dies with
    # 'XLAL Error - NRSurRemnant_LoadH5File: I/O error'. Carry the file in the
    # image, which is cached per site, rather than transferring it per job.
    mkdir -p /opt/lalsimulation-data
    GIT_LFS_SKIP_SMUDGE=1 git clone --depth 1 \
        https://git.ligo.org/waveforms/software/lalsuite-waveform-data.git \
        /tmp/lalsuite-waveform-data
    cd /tmp/lalsuite-waveform-data
    git lfs pull --include "waveform_data/NRSur7dq4Remnant_v1.0.h5"
    mv waveform_data/NRSur7dq4Remnant_v1.0.h5 /opt/lalsimulation-data/
    cd /
    rm -rf /tmp/lalsuite-waveform-data

    # cleanup
    apt-get clean -y
    pip cache purge
